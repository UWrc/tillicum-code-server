---
script:
  native:
    - "--gpus"
    - "<%= num_gpus %>"
    - "--ntasks"
    - "1"
    - "--cpus-per-task"
    - "<%= num_cpus %>"
    - "--time"
    - "<%= num_hours %>:<%= num_mins %>:00"
    <%-
    unless extra_slurm_args.empty? or enable_slurm_args == "0"
      args = extra_slurm_args.split
      args.each do |arg|
    -%>
    - "<%= arg %>"
    <%-
      end
    end
    -%>
